# ======================
# Broker Configuration
# ======================
# Choose broker: "mt5" or "oanda" or "demo"
BROKER_TYPE=demo

# MetaTrader 5 (Windows only)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# OANDA
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# ======================
# Trading Configuration
# ======================
SYMBOLS=EURUSD,GBPUSD
TIMEFRAME=H1
RISK_PER_TRADE=1.0
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS_PCT=5.0
MAX_WEEKLY_LOSS_PCT=10.0
MAX_DRAWDOWN_PCT=20.0
RR_RATIO=2.0

# ======================
# Strategy Configuration
# ======================
# Available: trend_following, mean_reversion, breakout
ACTIVE_STRATEGIES=trend_following

# Trend Following
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5

# Mean Reversion
BB_PERIOD=20
BB_STD=2.0
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Breakout
BREAKOUT_LOOKBACK=20
BREAKOUT_ATR_MULTIPLIER=0.5

# ======================
# Session Filter
# ======================
# Comma-separated: london,new_york,tokyo,sydney
TRADING_SESSIONS=london,new_york

# ======================
# Telegram Alerts
# ======================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ======================
# Logging
# ======================
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# ======================
# Backtesting
# ======================
BACKTEST_START=2021-01-01
BACKTEST_END=2024-12-31
BACKTEST_INITIAL_BALANCE=10000
